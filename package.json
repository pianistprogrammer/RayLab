{
  "name": "raylab-cluster-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @raylab/frontend dev\" \"sleep 3 && pnpm --filter @raylab/electron dev\"",
    "electron:dev": "pnpm --filter @raylab/electron dev",
    "frontend:dev": "pnpm --filter @raylab/frontend dev",
    "build": "pnpm --filter @raylab/frontend build && pnpm --filter @raylab/electron build",
    "frontend:build": "pnpm --filter @raylab/frontend build",
    "electron:build": "pnpm --filter @raylab/electron build",
    "test": "pnpm --filter @raylab/frontend test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "packageManager": "pnpm@9.12.1",
  "workspaces": [
    "frontend",
    "electron"
  ]
}
