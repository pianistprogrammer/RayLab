{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RayLab",
  "version": "0.3.0",
  "identifier": "lab.raylab.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir frontend dev",
    "beforeBuildCommand": "corepack pnpm --dir frontend build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "RayLab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
