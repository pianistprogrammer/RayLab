{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RayLab",
  "version": "0.1.0",
  "identifier": "lab.raylab.cluster-manager",
  "build": {
    "beforeDevCommand": "pnpm --filter @raylab/frontend dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @raylab/frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RayLab",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8765; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "Developer ID Application: Jeremiah Abimbola (2JA6D4683T)",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    },
    "resources": ["../sidecar", "../sidecar-bin", "../vendor"],
    "icon": ["icons/icon.png"]
  }
}
